#!/usr/bin/env python3
"""Recolor the active Omarchy theme from the current wallpaper.

Only the neutral roles (backgrounds, foregrounds, selection, muted) are derived
from the image; the accent stays whatever the theme defines. The semantic hue keys a theme defines -- red, green,
yellow and friends -- are left exactly as the theme shipped them, because a
"red" that stops being red breaks every urgency cue in the shell.

Any key the script does not recognise passes through untouched, so a theme with
a different schema (Catppuccin's color0..color15 vs Nord's named keys) still
comes out valid.

Writes to ~/.config/omarchy/themes/<theme>/colors.toml, which Omarchy prefers
over the packaged copy, so /usr/share is never touched and removing that file
restores the stock palette.
"""

from __future__ import annotations

import base64
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
STATE = HOME / ".local/state/omarchy/current"
USER_THEMES = HOME / ".config/omarchy/themes"

# Keys whose value should follow the wallpaper. Everything else is preserved,
# including `accent` and the selection tint: those carry the theme's identity
# (Mocha's mauve) and washing them out with whatever the image happens to
# contain loses exactly what makes the theme look designed.
NEUTRAL_KEYS = {
    "background",
    "dark_background",
    "darker_background",
    "lighter_background",
    "foreground",
    "dark_foreground",
    "light_foreground",
    "bright_foreground",
    "selection",
    "muted",
    "cursor",
    "selection_foreground",
}

HEX = re.compile(r"#([0-9a-fA-F]{6})")
ASSIGNMENT = re.compile(r'^(\s*)([A-Za-z0-9_-]+)(\s*=\s*)"?(#[0-9a-fA-F]{6})"?(.*)$')


def run(cmd: list[str]) -> str:
    return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout


def to_rgb(value: str) -> tuple[int, int, int]:
    value = value.lstrip("#")
    return int(value[0:2], 16), int(value[2:4], 16), int(value[4:6], 16)


def to_hex(rgb: tuple[float, float, float]) -> str:
    return "#{:02x}{:02x}{:02x}".format(*(max(0, min(255, round(c))) for c in rgb))


def luminance(rgb: tuple[int, int, int]) -> float:
    r, g, b = (c / 255 for c in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def saturation(rgb: tuple[int, int, int]) -> float:
    r, g, b = (c / 255 for c in rgb)
    high, low = max(r, g, b), min(r, g, b)
    if high == 0:
        return 0.0
    return (high - low) / high


def mix(a: tuple[int, int, int], b: tuple[int, int, int], amount: float) -> tuple[float, float, float]:
    return tuple(a[i] + (b[i] - a[i]) * amount for i in range(3))


def boost(rgb: tuple[int, int, int], min_value: float, min_saturation: float) -> tuple[int, int, int]:
    """Raise brightness and colorfulness to a floor, keeping the hue."""
    r, g, b = (c / 255 for c in rgb)
    high, low = max(r, g, b), min(r, g, b)
    value = max(high, min_value)
    sat = (high - low) / high if high > 0 else 0.0
    if high == low:  # true grey has no hue to preserve
        return tuple(round(value * 255) for _ in range(3))
    sat = max(sat, min_saturation)
    # Rebuild the color at the new value/saturation on the original hue.
    scaled = [(c - low) / (high - low) for c in (r, g, b)]
    return tuple(round((value * (1 - sat) + value * sat * s) * 255) for s in scaled)


def palette(image: Path, count: int = 8) -> list[tuple[int, int, int]]:
    """Dominant colors, most common first."""
    out = run([
        "magick", "-limit", "thread", "2", str(image),
        "-thumbnail", "120x120",
        "-colors", str(count),
        "-format", "%c",
        "histogram:info:",
    ])
    found: list[tuple[int, tuple[int, int, int]]] = []
    for line in out.splitlines():
        match = HEX.search(line)
        if not match:
            continue
        weight = line.strip().split(":")[0]
        try:
            found.append((int(weight), to_rgb(match.group(1))))
        except ValueError:
            continue
    found.sort(key=lambda item: item[0], reverse=True)
    return [rgb for _, rgb in found]


def derive(colors: list[tuple[int, int, int]]) -> dict[str, str]:
    if not colors:
        raise SystemExit("no colors extracted from wallpaper")

    by_light = sorted(colors, key=luminance)
    darkest = by_light[0]
    lightest = by_light[-1]

    # A wallpaper can be entirely mid-tone, so the extremes are pushed until the
    # pair is actually readable rather than trusted as-is.
    background = darkest if luminance(darkest) <= 0.18 else mix(darkest, (0, 0, 0), 0.62)
    background = tuple(background)
    foreground = lightest if luminance(lightest) >= 0.78 else mix(lightest, (255, 255, 255), 0.72)
    foreground = tuple(foreground)

    # The accent is the most colorful thing on screen, then forced into a band
    # where it stays visible: a drab or very dark wallpaper would otherwise
    # yield an accent that disappears against the background it sits on.
    candidates = [c for c in colors if 0.2 < luminance(c) < 0.9] or colors
    accent = max(candidates, key=saturation)
    accent = boost(accent, min_value=0.62, min_saturation=0.35)

    bg = tuple(round(c) for c in background)
    fg = tuple(round(c) for c in foreground)

    return {
        "background": to_hex(bg),
        "dark_background": to_hex(mix(bg, (0, 0, 0), 0.35)),
        "darker_background": to_hex(mix(bg, (0, 0, 0), 0.55)),
        "lighter_background": to_hex(mix(bg, fg, 0.12)),
        "foreground": to_hex(fg),
        "bright_foreground": to_hex(fg),
        "light_foreground": to_hex(mix(fg, bg, 0.2)),
        "dark_foreground": to_hex(mix(fg, bg, 0.55)),
        "selection": to_hex(mix(bg, accent, 0.35)),
        "muted": to_hex(mix(bg, fg, 0.45)),
        "cursor": to_hex(fg),
        "selection_foreground": to_hex(bg),
    }


def main() -> int:
    theme_name = (STATE / "theme.name").read_text().strip()
    wallpaper = (STATE / "background").resolve()
    if not wallpaper.is_file():
        raise SystemExit(f"wallpaper not found: {wallpaper}")

    # This runs from a watcher on the state directory, and the refresh below
    # writes into that same directory. Without this guard the two would chase
    # each other forever; with it, the echo of our own write is a no-op.
    stamp = STATE.parent / "wallpaper-theme.stamp"
    fingerprint = f"{theme_name}\n{wallpaper}\n"
    if "--force" not in sys.argv and stamp.is_file() and stamp.read_text() == fingerprint:
        return 0

    target_dir = USER_THEMES / theme_name
    target = target_dir / "colors.toml"
    target_dir.mkdir(parents=True, exist_ok=True)

    # The stock palette is the template: it defines which keys exist and keeps
    # the hue keys. Kept aside on first run so the theme can be restored.
    # Stored outside the theme folder, which `omarchy theme refresh`
    # materialises wholesale.
    backup_dir = USER_THEMES / ".stock-colors"
    backup_dir.mkdir(parents=True, exist_ok=True)
    stock_backup = backup_dir / f"{theme_name}.toml"
    if stock_backup.exists():
        template = stock_backup.read_text()
    else:
        # Prefer the packaged palette: the user copy may already be a previous
        # run's output, and backing that up would lose the real original.
        candidates = [
            Path("/usr/share/omarchy/themes") / theme_name / "colors.toml",
            STATE / "theme/colors.toml",
            target,
        ]
        source = next((c for c in candidates if c.is_file()), None)
        if source is None:
            raise SystemExit(f"no palette to start from for theme '{theme_name}'")
        template = source.read_text()
        stock_backup.write_text(template)

    derived = derive(palette(wallpaper))

    lines = []
    for line in template.splitlines():
        match = ASSIGNMENT.match(line)
        if match and match.group(2) in NEUTRAL_KEYS and match.group(2) in derived:
            indent, key, sep, _, rest = match.groups()
            lines.append(f'{indent}{key}{sep}"{derived[key]}"{rest}')
        else:
            lines.append(line)
    target.write_text("\n".join(lines) + "\n")

    # `theme refresh` re-renders every templated config from colors.toml.
    # `theme set` is deliberately avoided: it also cycles the background, which
    # would retrigger whatever called this script.
    env = dict(os.environ, OMARCHY_PATH="/usr/share/omarchy")
    subprocess.run(["omarchy", "theme", "refresh"], env=env, check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # Refresh rewrites the files but does not tell the running shell, which
    # reads its palette once at startup. This is the same IPC `theme set` uses,
    # minus the background handling that would retrigger this script.
    def payload(path: Path) -> str:
        return base64.b64encode(path.read_bytes()).decode() if path.is_file() else ""

    subprocess.run(
        ["omarchy-shell", "shell", "applyTheme",
         payload(STATE / "theme/colors.toml"), payload(STATE / "theme/shell.toml")],
        env=env, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )

    stamp.write_text(fingerprint)
    print(f"{theme_name}: recolored from {wallpaper.name} (background {derived['background']})")
    return 0


if __name__ == "__main__":
    if shutil.which("magick") is None:
        raise SystemExit("ImageMagick (magick) is required")
    sys.exit(main())
