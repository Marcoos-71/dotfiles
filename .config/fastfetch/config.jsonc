{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "raw",
    "source": "[38;2;203;166;247m████[38;2;137;180;250m████[38;2;148;226;213m████[0m\n[38;2;203;166;247m████[38;2;137;180;250m████[38;2;148;226;213m████[0m\n[38;2;166;227;161m████[38;2;249;226;175m████[38;2;243;139;168m████[0m\n[38;2;166;227;161m████[38;2;249;226;175m████[38;2;243;139;168m████[0m\n",
    "padding": {
      "top": 1,
      "right": 4,
      "left": 2
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "  [35m [34m [36m [32m [33m [31m [37m "
    },
    "break",
    {
      "type": "os",
      "key": "  OS",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key": "󠀬  WM",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "  Shell",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "󰎠  CPU",
      "keyColor": "magenta",
      "showPeCoreCount": false
    },
    {
      "type": "gpu",
      "format": "{2}",
      "key": "󰍛  GPU",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "󰅛  RAM",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "󡃐  Uptime",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "custom",
      "format": "  [35m [34m [36m [32m [33m [31m [37m "
    }
  ]
}
