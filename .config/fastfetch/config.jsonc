{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "raw",
    "source": "\u001b[38;2;203;166;247m████\u001b[38;2;137;180;250m████\u001b[38;2;148;226;213m████\u001b[0m\n\u001b[38;2;203;166;247m████\u001b[38;2;137;180;250m████\u001b[38;2;148;226;213m████\u001b[0m\n\u001b[38;2;166;227;161m████\u001b[38;2;249;226;175m████\u001b[38;2;243;139;168m████\u001b[0m\n\u001b[38;2;166;227;161m████\u001b[38;2;249;226;175m████\u001b[38;2;243;139;168m████\u001b[0m\n",
    "padding": {
      "top": 1,
      "right": 4,
      "left": 2
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "  \u001b[35m \u001b[34m \u001b[36m \u001b[32m \u001b[33m \u001b[31m \u001b[37m \u001b[0m"
    },
    "break",
    {
      "type": "os",
      "key": "  OS",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key": "󠀬  WM",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "  Shell",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "󰎠  CPU",
      "keyColor": "magenta",
      "showPeCoreCount": false
    },
    {
      "type": "gpu",
      "format": "{2}",
      "key": "󰅙  GPU",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "󰅛  RAM",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "󡃐  Uptime",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "custom",
      "format": "  \u001b[35m \u001b[34m \u001b[36m \u001b[32m \u001b[33m \u001b[31m \u001b[37m \u001b[0m"
    }
  ]
}